# Credentials for grafana-sync.
#
# The live copy belongs at /etc/grafana-ad-syncher.env on the server, NOT in this
# directory: deploy.sh wipes the whole checkout on every run, so anything stored
# here is destroyed. deploy.sh copies /etc/grafana-ad-syncher.env to deploy/.env
# after cloning, which is where docker compose reads ${VAR} substitutions from.
#
#   install -m 600 /dev/null /etc/grafana-ad-syncher.env
#   vi /etc/grafana-ad-syncher.env      # fill in the values below
#   ./deploy.sh
#
# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
# Creating users (POST /api/admin/users) and looking them up
# (GET /api/users/lookup) both require *Grafana server admin*, which is a
# different thing from the org-level "Admin" role. A service account token can
# never hold it, so with a glsa_* token those two calls fail and no user is ever
# created or resolved globally.
#
# Use either:
#   a) a local Grafana user with the "Grafana Admin" flag set — user + password,
#      token left EMPTY. Required if the syncer must create users.
#   b) a service account token — no user creation, and users resolve only from
#      the org member list.
#
# If GRAFANA_ADMIN_TOKEN is non-empty it always wins and the password is never
# sent. Leave it empty to use basic auth.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_GRAFANA_PASSWORD
GRAFANA_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Entra / Microsoft Graph
# ---------------------------------------------------------------------------
ENTRA_TENANT_ID=REPLACE_ME_TENANT_ID
ENTRA_CLIENT_ID=REPLACE_ME_CLIENT_ID
ENTRA_CLIENT_SECRET=REPLACE_ME_CLIENT_SECRET
