# =============================================================================
# grafana-sync configuration - this is the ONLY place settings live.
# =============================================================================
#
# This file is the template. The live copy is deploy/.env, right next to
# docker-compose.yml, which loads it wholesale via `env_file:`. The compose file
# itself contains no settings and no secrets - it is tracked in a public git
# repository, this file is not (.gitignore covers deploy/.env).
#
# You do not have to create it by hand. The first ./deploy.sh on a host copies
# this template into place and stops so you can fill it in:
#
#   ./deploy.sh                                     # creates deploy/.env, exits
#   vi /docker/grafana-ad-syncher/deploy/.env       # fill in the values
#   ./deploy.sh                                     # deploys
#
# deploy.sh wipes and re-clones the checkout on every run but stashes deploy/.env
# across the wipe, so it survives.
#
# SYNTAX: KEY=value, one per line. No quotes - they would become part of the
# value. No inline comments after a value, for the same reason. Comments only on
# their own line.
#
# -----------------------------------------------------------------------------
# Service
# -----------------------------------------------------------------------------
LISTEN_ADDR=:8080
DATA_DIR=/data

# Tick interval for the auto-sync loop. "0" means the loop goroutine is never
# started at all, so nothing can sync unattended - not even if the
# "Automatische Updates" toggle in the UI is switched back on.
#
# Held at 0 deliberately until a manual plan has been validated: unattended
# syncing every 15 minutes is what let a broken user lookup go unnoticed for
# months. Restore 15m afterwards.
SYNC_INTERVAL=0

# Forces the persisted auto-sync flag to this value on every container start,
# overriding whatever the UI toggle has stored. Belt and braces alongside
# SYNC_INTERVAL=0: this clears the flag, that removes the loop.
#
# Note the loop runs once immediately on start, before waiting for the first
# tick - so a restart with the flag set syncs straight away.
AUTO_SYNC_ON_START=false

# -----------------------------------------------------------------------------
# Sync behaviour
# -----------------------------------------------------------------------------
# Viewer, Editor or Admin.
DEFAULT_USER_ROLE=Viewer
ALLOW_CREATE_USERS=true

# Kept off deliberately: removals are the only destructive action here, and they
# ran unchecked while additions were silently failing. Turn back on after
# verifying a plan.
ALLOW_REMOVE_TEAM_MEMBERS=false

# -----------------------------------------------------------------------------
# Grafana connection
# -----------------------------------------------------------------------------
# Talk to the grafana container directly inside the shared docker network. The
# grafana container listens on https/443 (TLS terminated inside grafana itself);
# its certificate is for grafana-prd.advanzia.com, so TLS verification has to be
# skipped when using the container alias `grafana`.
GRAFANA_URL=https://grafana:443
GRAFANA_INSECURE_TLS=true

# Verbose connection logging (DNS / TCP / TLS / TTFB per request, /etc/hosts
# dump + reachability probe at startup). Set to false once things are stable.
GRAFANA_DEBUG=true

# -----------------------------------------------------------------------------
# Grafana credentials
# -----------------------------------------------------------------------------
# Creating users (POST /api/admin/users) and looking them up
# (GET /api/users/lookup) both require *Grafana server admin*, which is a
# different thing from the org-level "Admin" role. A service account token can
# never hold it, so with a glsa_* token those two calls fail and no user is ever
# created or resolved globally.
#
# Use either:
#   a) a local Grafana user with the "Grafana Admin" flag set - user + password,
#      token left EMPTY. Required if the syncer must create users.
#   b) a service account token - no user creation, and users resolve only from
#      the org member list.
#
# If GRAFANA_ADMIN_TOKEN is non-empty it always wins and the password is never
# sent. Leave it empty to use basic auth.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_GRAFANA_PASSWORD
GRAFANA_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# Entra / Microsoft Graph
# -----------------------------------------------------------------------------
# The app registration needs User.Read.All and Group.Read.All.
ENTRA_TENANT_ID=REPLACE_ME_TENANT_ID
ENTRA_CLIENT_ID=REPLACE_ME_CLIENT_ID
ENTRA_CLIENT_SECRET=REPLACE_ME_CLIENT_SECRET

# Only needed for sovereign clouds; the defaults are the global endpoints.
#ENTRA_AUTHORITY_BASE_URL=https://login.microsoftonline.com
#GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0

# -----------------------------------------------------------------------------
# Troubleshooting API  (/api/logs/*, same port as the web UI)
# -----------------------------------------------------------------------------
# Bearer token guarding the log endpoints.
#
# FORMAT: any non-empty string, no length or character rules. Generate one:
#
#   openssl rand -hex 32
#
# That prints 64 hex characters. Paste the whole line after API_TOKEN= below -
# no quotes, no spaces. If openssl is not available:
#
#   head -c 32 /dev/urandom | base64 | tr -d '=+/'
#   cat /proc/sys/kernel/random/uuid
#
# Leaving it empty is also fine: the app then mints one on first start, keeps it
# in the data volume and prints it once to the container log:
#
#   docker logs grafana-sync | grep "shown here once"
#
# There is no unauthenticated mode - with no token at all the endpoints answer
# 404. Treat this like a password: /api/logs/docker reads the docker daemon
# socket, which is root-equivalent on the host.
API_TOKEN=

# How many recent app log lines are kept in memory for /api/logs/app.
# Roughly 200 bytes per line.
LOG_BUFFER_LINES=5000

# Daemon socket for /api/logs/docker, and the container it reads when no
# ?container= is passed.
DOCKER_SOCKET=/var/run/docker.sock
CONTAINER_NAME=grafana-sync

# Written automatically by deploy.sh from the owner of /var/run/docker.sock.
# Only set it by hand if you run docker compose without deploy.sh.
#DOCKER_GID=999
